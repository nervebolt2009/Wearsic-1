{
  "name": "Wear OS 5+ Dev Environment (No Emulator)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "java.home": "/usr/lib/jvm/java-17-openjdk-amd64",
        "android.sdk": "/home/vscode/android-sdk"
      },
      "extensions": [
        "vscjava.vscode-java-pack",
        "mathiasfrohlich.Kotlin",
        "fwcd.kotlin"
      ]
    }
  },
  "containerEnv": {
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64",
    "ANDROID_HOME": "/home/vscode/android-sdk",
    "ANDROID_SDK_ROOT": "/home/vscode/android-sdk"
  },
  "mounts": [
    "source=gradle-cache-${devcontainerId},target=/home/vscode/.gradle,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  }
}
