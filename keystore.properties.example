# Copy this file to keystore.properties and fill in your release signing values.
# keystore.properties is gitignored so the secrets never land in the repository.
# Alternatively, set the WEARSIC_STORE_FILE / WEARSIC_STORE_PASSWORD /
# WEARSIC_KEY_ALIAS / WEARSIC_KEY_PASSWORD environment variables (e.g. in CI).
storeFile=wearsic-release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
